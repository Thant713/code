[
  {
    "context": "!Editor",
    "bindings": {
      "k": "menu::SelectPrevious",
      "j": "menu::SelectNext"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-j": "editor::DuplicateLineDown",
      "cmd-[": "editor::Fold",
      "cmd-]": "editor::UnfoldLines",
      "cmd-alt-[": "editor::FoldAll",
      "cmd-alt-]": "editor::UnfoldAll"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-f": "zed::OpenSettingsFile",
      "alt-k": "zed::OpenKeymapFile",
      "cmd-\\": "workspace::ActivatePreviousPane"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "alt-z": "project_panel::NewFile",
      "alt-x": "project_panel::NewDirectory"
    }
  },
  {
    "bindings": {
      "alt-q": "workspace::ToggleLeftDock",
      "alt-w": "workspace::ToggleRightDock",
      "alt-e": "project_panel::ToggleFocus",
      "alt-d": "agent::ToggleFocus",
      "alt-s": "editor::ToggleFocus"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "enter": "project_panel::Open",
      "f2": "project_panel::Rename"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-c": "agent::AddSelectionToThread"
    }
  }
]
